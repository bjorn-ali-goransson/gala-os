<?xml version="1.0" encoding="utf-8"?>
<!-- A dual-purpose package (the SDK's "Single Package Authoring":
     ALLUSERS=2 and MSIINSTALLPERUSER=1 by default) for galapkg's
     install-plan tests: a 32-bit directory under ProgramFilesFolder, a
     registry value under Root -1 (HKMU) and one under Root 0 (HKCR), a
     Start menu shortcut. make_fixtures.sh adds the Root 0 row. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="33333333-2222-3333-4444-555555555555" Name="Gala Dual" Language="1033"
           Version="3.1.0" Manufacturer="Gala" UpgradeCode="33333333-2222-3333-4444-666666666666">
    <Package InstallerVersion="500" Compressed="yes"/>
    <Media Id="1" Cabinet="dual.cab" EmbedCab="yes"/>
    <Property Id="ALLUSERS" Value="2"/>
    <Property Id="MSIINSTALLPERUSER" Value="1"/>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="APPDIR" Name="Gala Dual">
          <Component Id="App" Guid="33333333-2222-3333-4444-000000000001">
            <File Id="app.txt" Name="app.txt" Source="core.txt" KeyPath="yes"/>
            <RegistryValue Root="HKMU" Key="Software\Gala\Dual" Name="Dir" Type="string"
                           Value="[APPDIR]"/>
            <Shortcut Id="AppMenu" Name="Gala Dual" Directory="ProgramMenuFolder"
                      Target="[#app.txt]"/>
          </Component>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder"/>
    </Directory>
    <Feature Id="Complete" Level="1">
      <ComponentRef Id="App"/>
    </Feature>
  </Product>
</Wix>
