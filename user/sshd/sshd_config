# gala's sshd configuration for the `sshd` scenario (Win32-OpenSSH reads
# %ProgramData%\ssh\sshd_config; install-sshd.ps1 would copy its default
# there). Written for gala from the options documented in sshd_config(5).
Port 22
AuthorizedKeysFile .ssh/authorized_keys
PasswordAuthentication yes
Subsystem sftp sftp-server.exe
# Where sshd finds its per-connection program (sshd_config(5) of 9.8).
SshdSessionPath "C:\Program Files\OpenSSH\sshd-session.exe"
